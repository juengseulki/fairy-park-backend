generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nickname  String

  refreshTokens RefreshToken[]
  favorites Favorite[]
  histories     ParkingHistory[]
  searchHistories SearchHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Favorite {
  id         String   @id @default(uuid())
  parkingId  String
  userId     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parkingId, userId])
}

model ParkingHistory {
  id         String   @id @default(uuid())
  userId     String
  parkingId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  viewedAt DateTime @updatedAt

  @@unique([userId, parkingId])
}

model SearchHistory {
  id         String   @id @default(uuid())
  userId     String
  keyword    String
  count      Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  searchedAt DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([userId, keyword])
}